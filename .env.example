# Required for GitHub operations
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required for creating real bounties (unless DRY_RUN=true)
# Can be a base58 private key or JSON array of bytes
SOLANA_PRIVATE_KEY=

# stage (default) or production
GIBWORK_ENVIRONMENT=stage

# Set to true to avoid spending funds / calling write endpoints
DRY_RUN=true

# Defaults used when creating bounties from issues
DEFAULT_REWARD_AMOUNT=25.00
DEFAULT_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
DEFAULT_MIN_SUBMISSION=5.00
DEFAULT_TAGS=github,open-source

# Label that triggers the GitHub Action
LABEL_TRIGGER=gibwork-bounty
